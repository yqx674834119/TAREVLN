diff --git a/src/vlm_node/vlm_node/deepseek_client.py b/src/vlm_node/vlm_node/deepseek_client.py
new file mode 100644
index 0000000..7bbf9c9
--- /dev/null
+++ b/src/vlm_node/vlm_node/deepseek_client.py
@@ -0,0 +1,63 @@
+"""OpenAI-compatible transport for the upstream SysNav typed query interface.
+
+Only the wire format changes: JSON mode plus local Pydantic validation. Native
+query queues, prompts, images, and result consumers remain in vlm_reasoning_node.
+"""
+import inspect
+import json
+import os
+from pathlib import Path
+import threading
+import time
+from types import SimpleNamespace
+
+from openai import OpenAI
+
+
+class DeepSeekClient:
+    def __init__(self, api_key, base_url):
+        self.client = OpenAI(api_key=api_key, base_url=base_url, timeout=40, max_retries=2)
+        self.beta = SimpleNamespace(chat=SimpleNamespace(completions=self))
+        self.lock = threading.Lock()
+        self.limit = threading.BoundedSemaphore(3)
+        self.calls = 0
+        self.log = Path(os.environ.get('SYSNAV_API_LOG', 'debug/api.jsonl'))
+
+    def parse(self, *, model, messages, response_format):
+        frame = inspect.currentframe().f_back
+        purpose = frame.f_code.co_name
+        node = frame.f_locals.get('self')
+        simulation_time = node.get_clock().now().nanoseconds/1e9 if node is not None else None
+        messages = list(messages)
+        schema = response_format.model_json_schema()
+        messages[0] = {**messages[0], 'content': messages[0]['content'] +
+                       '\nReturn a JSON object matching this schema: ' + json.dumps(schema) +
+                       '\nGive only concise observations and the decision reason. Do not provide private deliberation.'}
+        with self.limit:
+            with self.lock:
+                self.calls += 1
+                call_id = self.calls
+                if call_id > int(os.environ.get('SYSNAV_MAX_API_CALLS', '150')):
+                    raise RuntimeError('SysNav API call budget exhausted')
+            start = time.monotonic()
+            row = {'id': call_id, 'purpose': purpose, 'model': model, 'time': simulation_time,
+                   'images': sum(b.get('type') == 'image_url' for m in messages
+                                 for b in (m['content'] if isinstance(m['content'], list) else []))}
+            try:
+                result = self.client.chat.completions.create(
+                    model=model, messages=messages, temperature=0, max_tokens=1800,
+                    response_format={'type': 'json_object'}, extra_body={'thinking': {'type': 'disabled'}})
+                raw = result.choices[0].message.content
+                parsed = response_format.model_validate_json(raw)
+                row.update(status='ok', result=parsed.model_dump(), usage=result.usage.model_dump())
+                return SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(parsed=parsed, content=raw))])
+            except Exception as exc:
+                # Record only exception class: HTTP messages may contain credentials.
+                row.update(status='error', error_type=type(exc).__name__)
+                raise RuntimeError(f'DeepSeek {purpose} failed: {type(exc).__name__}') from None
+            finally:
+                row['seconds'] = time.monotonic() - start
+                with self.lock:
+                    self.log.parent.mkdir(parents=True, exist_ok=True)
+                    with self.log.open('a') as stream:
+                        stream.write(json.dumps(row) + '\n')
